locals {

  ign_priority_class = {
    "aws" = "system-cluster-critical",
    "gcp" = "nginx-critical"
  }

  ign_sysctls = {
    "aws" = <<YAML
  sysctls:
    "net.core.somaxconn": "65535"
    "net.ipv4.ip_local_port_range": "1024 60999"
    "net.ipv4.tcp_tw_reuse": 1
YAML
    "gcp" = <<YAML
  sysctls:
    "net.ipv4.ip_local_port_range": "1024 60999"
YAML
  }

  prometheusSelector = "prometheus-ingress-nginx"

