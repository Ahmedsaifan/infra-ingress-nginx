          "pluginVersion": "4.0.2",
          "queryType": "table",
          "rawSql": "SELECT date, message, remote_addr_ipv6, host, method, path, version, status, request_time_sec, request_length_bytes, http_referer, http_user_agent, body_bytes_sent, ingress_name, proxy_upstream_name, upstream_response_length_bytes, upstream_response_time_sec, upstream_status \nFROM \"logs\".\"ingress_nginx\" \nWHERE ( date >= $__fromTime ) AND ( date <= $__toTime ) AND ( log_type IN($log_type) )\nAND ( ingress_name IN($ingress_name) ) \nAND ( host IN($host) ) \nAND ( status IN($status) ) \nAND ( path like '$path' ) \nAND ( toString(remote_addr_ipv6) like '$remote_addr_ipv6' ) \nORDER BY date DESC\nLIMIT $limit",
